# Copy to .streamlit/secrets.toml for local runs, or paste into the host's "Secrets" box
# (Streamlit Community Cloud: App settings -> Secrets; Hugging Face: Space settings -> Secrets).
# Without a key the app still works; only "Generate marketing strategy" needs it.
GEMINI_API_KEY = "your_key_here"

# Optional
# GEMINI_MODEL = "gemini-flash-latest"
# GEMINI_FALLBACK_MODEL = "gemini-flash-lite-latest"
# MAX_ANALYZE_ROWS = 2000     # cap uploads on small hosts (0 / unset = unlimited)
